          aria-controls="dropdown-abf2de598dbcc7bcbb8b-1"
        >
          <span class="accordion-item__title">What is Pathways Within?</span>
          <div class="accordion-icon-container" aria-hidden="true">
            
              <div class="plus">
                <div class="plus__horizontal-line"></div>
                <div class="plus__vertical-line"></div>
              </div>
            
